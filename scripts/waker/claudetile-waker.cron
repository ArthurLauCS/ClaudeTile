# Server-side schedule: independent of Windows, VPS timezone and daylight saving.
CRON_TZ=Asia/Shanghai
SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin
# Up to 5 short attempts per run; waker.py keeps the exact minutes (08:00-08:04, 13:01-13:05,
# 18:02-18:06, 23:03-23:07).
0-7 8,13,18,23 * * * claudetile-waker /usr/bin/python /opt/claudetile-waker/waker.py wake >/dev/null 2>&1
