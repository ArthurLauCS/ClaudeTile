# Server-side schedule: independent of Windows, VPS timezone and daylight saving.
CRON_TZ=Asia/Shanghai
SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin
# Up to 5 short attempts per run; waker.py keeps the exact minutes (07:00-07:04, 12:01-12:05,
# 17:02-17:06, 22:03-22:07).
0-7 7,12,17,22 * * * claudetile-waker /usr/bin/python /opt/claudetile-waker/waker.py wake >/dev/null 2>&1
